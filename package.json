{
	"name": "piem",
	"version": "1.10.1",
	"description": "Run the Piem coding agent in a chat side panel, with tools scoped to your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "bun test",
		"lint": "eslint .",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:skills": "node scripts/check-skills.mjs",
		"check:copy": "node scripts/check-copy.mjs",
		"check:css": "node scripts/check-css.mjs",
		"check:version": "node scripts/check-version.mjs",
		"release": "node scripts/release.mjs",
		"verify": "npm run build && npm run check:bundle && npm run check:skills && npm run check:copy && npm run check:css && npm run check:version && bun test && npm run lint"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "^1.4.2",
