{
	"name": "piem",
	"version": "1.0.40",
	"description": "Run the Piem coding agent in a chat side panel, with tools scoped to your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "bun test",
		"lint": "eslint .",
		"check:bundle": "node scripts/check-bundle.mjs",
		"check:copy": "node scripts/check-copy.mjs",
		"check:css": "node scripts/check-css.mjs",
		"check:version": "node scripts/check-version.mjs",
		"release": "node scripts/release.mjs",
		"verify": "npm run build && npm run check:bundle && npm run check:copy && npm run check:css && npm run check:version && bun test && npm run lint"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/bun": "^1.3.11",
		"@types/node": "^22.19.17",
		"@types/react": "18.3.27",
		"@types/react-dom": "18.3.7",
		"electron": "^44.0.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"happy-dom": "^20.11.6",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.3",
		"@earendil-works/pi-ai": "^0.84.3",
		"@modelcontextprotocol/client": "^2.0.0",
		"obsidian": "1.13.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	}
}
